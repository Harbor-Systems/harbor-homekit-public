+func TestSnapshotConsumerRequiresH264(t *testing.T) {
+	cons := newSnapshotConsumer()
+	codecs := cons.Medias[0].Codecs
+	if len(codecs) != 1 || codecs[0].Name != "H264" {
+		t.Fatalf("snapshot codecs = %#v, want H264 only", codecs)
+	}
