+func newSnapshotConsumer() *magic.Keyframe {
+	cons := magic.NewKeyframe()
+	// Don't take snapshots from Harbor's raw H265 ingest. Its first decoded
+	// frame can be gray and its keyframe interval can exceed Apple Home's
+	// request deadline. Use the continuously preloaded H264 FFmpeg path so
+	// every controller request receives a fresh, self-contained keyframe.
+	cons.Medias[0].Codecs = []*core.Codec{{Name: core.CodecH264}}
+	return cons
+}
